    abstract class Assignee {
        + {static} kMaxCodeLength : size_t = 10
        - code_ : string
        - name_ : string
        # Assignee(code : string, name : string)
        + ~Assignee() {virtual}
        + getCode() : const string&
        + getName() : const string&
        + setName(name : string)
        + {abstract} kind() : AssigneeKind
        + describe() : string
        - {abstract} contactDetails() : string
    }
    class Courier <<final>> {
        - phone_ : string
        + Courier(code : string, name : string)
        + Courier(code : string, name : string, phone : string)
        + getPhone() : const string&
        + setPhone(phone : string)
        + kind() : AssigneeKind
        - contactDetails() : string
    }
    class Office <<final>> {
        - address_ : string
        + Office(code : string, name : string)
