' ---------------------------------------------------------------- Manager
package "Manager" {
    class LogisticsManager {
        - factory_ : PackageFactory
        - packages_ : unordered_map<TrackingId, unique_ptr<Package>>
        - expressQueue_ : queue<TrackingId>
        - regularQueue_ : queue<TrackingId>
        - observers_ : vector<StatusObserver*>
        - commands_ : CommandHistory
        - assignees_ : unordered_map<string, unique_ptr<Assignee>>
        - history_ : vector<OperationRecord>
        + LogisticsManager()
        + LogisticsManager(lastIssued : TrackingId)
        .. shipments ..
        + accept(type, weightKg, dimensions, recipient, destination, declaredValue) : const Package&
        + accept(type, weightKg, dimensions, recipient, destination) : const Package&
        + contains(id : const TrackingId&) : bool
        + get(id : const TrackingId&) : const Package&
        + packageCount() : size_t
        + filter(predicate : const function<bool(const Package&)>&) : vector<const Package*>
        + undelivered() : vector<const Package*>
        .. delivery and observers ..
        + attach(observer : StatusObserver&)
        + detach(observer : StatusObserver&)
        + observerCount() : size_t
        + changeStatus(id : const TrackingId&, newStatus : PackageStatus)
        + dispatchNext() : optional<TrackingId>
        + waitingCount() : size_t
        .. commands ..
        + reroute(id : const TrackingId&, destination : string)
        + reroute(id : const TrackingId&, destination : string, recipient : string)
        + modify(id : const TrackingId&, details : const ParcelDetails&)
        + assign(id : const TrackingId&, code : const string&)
        + unassign(id : const TrackingId&)
        + undo() : bool
        + redo() : bool
        + canUndo() : bool
        + canRedo() : bool
        .. couriers and offices ..
        + addAssignee(assignee : unique_ptr<Assignee>) : const Assignee&
        + hasAssignee(code : const string&) : bool
        + getAssignee(code : const string&) : const Assignee&
        + assigneeCount() : size_t
        + assignees() : vector<const Assignee*>
        + assignedTo(code : const string&) : vector<const Package*>
        .. history and loading ..
        + history() : const vector<OperationRecord>&
        + cancelledOperations() : vector<OperationRecord>
        + restore(type, id, parcel, recipient, destination, status, assigneeCode) : const Package&
        + restoreRecord(record : OperationRecord)
    }
    note top of LogisticsManager
      Not copyable or movable (observers and commands hold
      references into it). <b>Observer</b> subject: changeStatus()
      notifies the attached observers for priority shipments.
      Delivery queues: express first, then regular (FIFO).
      Every change is written to history_; undone ones form
      the history of cancelled operations.
    end note
}

LogisticsManager "1" *-- "1" PackageFactory
LogisticsManager "1" *-- "0..*" Package : packages_\nkey: TrackingId
LogisticsManager "1" *-- "1" CommandHistory
